@using Ray.BiliBiliTool.Agent
@using Ray.BiliBiliTool.Web.Services.Pages.BiliAccount
@implements IAsyncDisposable
@inject IBiliPasswordLoginService LoginService
@inject IBiliAccountPageWorkflow Workflow
@inject IJSRuntime JS

<MudDialog Class="bili-account-login-modal">
    <DialogContent>
        <div class="bili-login-dialog">
        <section class="bili-login-qr-column" aria-label="扫码登录">
            @if (!_loginClaimed)
            {
                <QrLoginPanel OnAuthenticated="AcceptCookieAsync" />
            }
            else
            {
                <div class="bili-login-qr">
                    <MudText Typo="Typo.h6">登录确认</MudText>
                    <div class="bili-login-qr-frame">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                    </div>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">已获取登录状态</MudText>
                </div>
            }
        </section>
        <section class="bili-login-password-column" aria-label="账号密码登录">
        <MudStack Spacing="3">
            <MudText Typo="Typo.h6">@(_pendingCookie is not null ? "保存账号" : "账号密码登录")</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">登录成功后保存登录状态，密码仅用于本次登录。</MudText>
            @if (_pendingCookie is not null)
            {
                <MudAlert Severity="Severity.Success">登录已完成，正在保存账号。</MudAlert>
            }
            else if (_verification)
            {
                <MudAlert Severity="Severity.Info">@_verificationMessage @(_verificationTarget ?? "")</MudAlert>
                <MudTextField T="string" @bind-Value="_code" Label="收到的验证码" Variant="Variant.Outlined" Immediate="true" Disabled="@Busy" autocomplete="one-time-code" />
                <MudButton Class="send-verification-code" Variant="Variant.Outlined" OnClick="SendCodeAsync" Disabled="@(Busy || _retrySeconds > 0)">
                    @(_retrySeconds > 0 ? $"{_retrySeconds} 秒后重新发送" : _codeSent ? "重新发送验证码" : "发送验证码")
                </MudButton>
            }
            else if (_officialUrl is not null)
            {
                <MudAlert Severity="Severity.Info">@_verificationMessage</MudAlert>
                <MudLink Href="@_officialUrl" Target="_blank" rel="noopener noreferrer">前往官网完成账号验证</MudLink>
                <MudButton OnClick="RestartAsync" Disabled="@Busy" Variant="Variant.Outlined">重新登录</MudButton>
            }
            else
            {
                <MudTextField T="string" @bind-Value="_username" Label="手机号或邮箱" Variant="Variant.Outlined" Immediate="true" Disabled="@Busy" autocomplete="username" />
                <MudTextField T="string" @bind-Value="_password" Label="密码" InputType="InputType.Password" Variant="Variant.Outlined" Immediate="true" Disabled="@Busy" autocomplete="current-password" />
            }

            @if (_captcha?.Type == "img")
            {
                <img src="@_captcha.Image" alt="图片验证码" style="max-width:180px;max-height:90px;" />
                <MudTextField T="string" @bind-Value="_imageCode" Label="图片验证码" Variant="Variant.Outlined" Immediate="true" Disabled="@Busy" autocomplete="off" />
            }
            <div id="@_captchaId"></div>
            @if (Busy || IsPreparingCaptcha)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.body2" role="status">@(Busy ? _progress : "正在加载验证码")</MudText>
            }
            @if (!string.IsNullOrEmpty(_message))
            {
                <MudAlert Severity="@(_messageIsError ? Severity.Error : Severity.Info)" role="status">@_message</MudAlert>
            }
            @if (_pendingCookie is null && _officialUrl is null && (_captcha?.Type == "img" || _messageIsError || (_captcha is null && !_verification)))
            {
                <MudButton Class="refresh-password-captcha" Size="Size.Small" OnClick="RefreshCaptchaAsync" Disabled="@(Busy || IsPreparingCaptcha)">刷新验证码</MudButton>
            }
            @if (_pendingCookie is not null)
            {
                <MudButton Class="password-login-submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="@Busy" OnClick="SaveAsync">重试保存账号</MudButton>
            }
            else if (_officialUrl is null)
            {
                <MudButton Class="password-login-submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!CanSubmit)" OnClick="SubmitAsync">@(_verification ? "验证并登录" : "登录")</MudButton>
            }
        </MudStack>
        </section>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CancelAsync">取消</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    private readonly string _captchaId = "password-captcha-" + Guid.NewGuid().ToString("N");
    private readonly CancellationTokenSource _lifetime = new();
    private readonly CancellationTokenSource _requests = new();
    private IJSObjectReference? _module;
    private PasswordLoginCaptcha? _captcha;
    private TaskCompletionSource<bool>? _captchaReady;
    private BiliCookie? _pendingCookie;
    private string _username = "", _password = "", _code = "", _imageCode = "";
    private string _progress = "", _verificationMessage = "";
    private string? _message, _verificationTarget, _officialUrl;
    private bool _busy, _saving, _loginClaimed, _verification, _messageIsError, _codeSent, _initializeWidget, _widgetReady, _disposed;
    private int _retrySeconds, _captchaGeneration;
    private bool Busy => _busy || _saving;
    private bool IsPreparingCaptcha => _captcha?.Type == "geetest" && !_widgetReady && _captchaReady is { Task.IsCompleted: false };

    private bool CanSubmit => !Busy && !_loginClaimed && (_verification
        ? _codeSent && !string.IsNullOrWhiteSpace(_code)
        : !string.IsNullOrWhiteSpace(_username) && _password.Length > 0 && (_captcha?.Type != "img" || !string.IsNullOrWhiteSpace(_imageCode)));

    protected override Task OnInitializedAsync() => RefreshCaptchaAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_initializeWidget || _captcha?.Type != "geetest" || _disposed)
            return;
        _initializeWidget = false;
        var generation = _captchaGeneration;
        var captcha = _captcha;
        var ready = _captchaReady;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", _requests.Token, "./password-login.js");
            if (_disposed || _loginClaimed || generation != _captchaGeneration) return;
            await _module.InvokeVoidAsync("initialize", _requests.Token, _captchaId, captcha);
            if (_disposed || _loginClaimed || generation != _captchaGeneration) return;
            _widgetReady = true;
            ready?.TrySetResult(true);
        }
        catch (Exception) { ready?.TrySetResult(false); if (!_disposed && !_loginClaimed && generation == _captchaGeneration) ShowError("验证码加载失败，请重新验证"); }
        if (!_disposed) StateHasChanged();
    }

    private async Task RefreshCaptchaAsync()
    {
        if (Busy || _loginClaimed || _pendingCookie is not null || _officialUrl is not null) return;
        await RunAsync("正在加载验证码", async () =>
        {
            await LoadCaptchaAsync();
        });
    }

    private async Task<PasswordLoginProof?> VerifyCaptchaAsync()
    {
        // Start every interactive verification with a new server ticket and SDK instance.
        if (_captcha?.Type != "img")
        {
            _progress = "正在更新验证码";
            await LoadCaptchaAsync();
        }
        if (_captcha?.Type == "img")
        {
            if (!string.IsNullOrWhiteSpace(_imageCode)) return new(ImageCode: _imageCode);
            _message = "请输入图片验证码后继续";
            return null;
        }
        var ready = _captchaReady;
        if (!_widgetReady && ready is not null)
        {
            StateHasChanged();
            if (!await ready.Task.WaitAsync(_requests.Token))
                throw new PasswordLoginException("验证码加载失败，请重新验证");
        }
        if (_module is null || !_widgetReady) throw new PasswordLoginException("验证码未准备好，请重新验证");
        _progress = "请完成验证码验证";
        StateHasChanged();
        try
        {
            var proof = await _module.InvokeAsync<PasswordLoginProof>("verify", _requests.Token, _captchaId);
            return proof.Cancelled ? null : proof;
        }
        catch (JSException) { throw new PasswordLoginException("验证码验证未完成，请重新验证"); }
        finally
        {
            _captcha = null;
            _widgetReady = false;
            await DestroyCaptchaWidgetAsync();
        }
    }

    private async Task SubmitAsync()
    {
        if (!CanSubmit) return;
        await RunAsync(_verification ? "正在验证账号" : "正在登录", async () =>
        {
            PasswordLoginResult result;
            if (_verification) result = await LoginService.VerifyAsync(_code, _requests.Token);
            else
            {
                var proof = await VerifyCaptchaAsync();
                if (proof is null) return;
                _progress = "正在登录";
                var password = _password;
                _password = "";
                StateHasChanged();
                try { result = await LoginService.LoginAsync(_username, password, proof, _requests.Token); }
                finally { password = ""; _captcha = null; _widgetReady = false; }
            }
            if (_disposed || _loginClaimed) return;
            switch (result.Status)
            {
                case PasswordLoginStatus.Success when result.Cookie is not null:
                    await AcceptCookieAsync(result.Cookie);
                    break;
                case PasswordLoginStatus.VerificationRequired:
                    _verification = true;
                    _verificationMessage = result.Message;
                    _verificationTarget = result.VerificationTarget;
                    _captcha = null;
                    _code = "";
                    break;
                case PasswordLoginStatus.OfficialVerificationRequired:
                    _officialUrl = result.VerificationUrl;
                    _verificationMessage = result.Message;
                    break;
                default:
                    ShowError(result.Message);
                    break;
            }
        });
    }

    private async Task SendCodeAsync()
    {
        if (Busy || _loginClaimed || _retrySeconds > 0) return;
        await RunAsync("正在发送验证码", async () =>
        {
            var proof = await VerifyCaptchaAsync();
            if (proof is null) return;
            try { await LoginService.SendVerificationCodeAsync(proof, _requests.Token); }
            finally { _captcha = null; _widgetReady = false; }
            _codeSent = true;
            _message = "验证码已发送，请查看手机或邮箱";
            _retrySeconds = LoginService.VerificationRetrySeconds;
            _ = CountDownAsync();
        });
    }

    private async Task CountDownAsync()
    {
        try
        {
            while (!_disposed && !_loginClaimed && _retrySeconds > 0)
            {
                await Task.Delay(1000, _lifetime.Token);
                _retrySeconds = LoginService.VerificationRetrySeconds;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task AcceptCookieAsync(BiliCookie cookie)
    {
        if (_disposed || _loginClaimed) return;
        _loginClaimed = true;
        _saving = true;
        _pendingCookie = cookie;
        _password = "";
        _code = "";
        _message = null;
        _requests.Cancel();
        _captchaReady?.TrySetResult(false);
        StateHasChanged();
        try
        {
            if (_module is not null)
            {
                try { await _module.InvokeVoidAsync("destroy", _captchaId); }
                catch (JSException) { }
                catch (JSDisconnectedException) { }
            }
            await PersistCookieAsync();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (PasswordLoginException ex) { if (!_disposed) ShowError(ex.Message); }
        finally { _saving = false; }
    }

    private Task SaveAsync() => RunAsync("正在保存账号", PersistCookieAsync, true);
    private async Task PersistCookieAsync()
    {
        _progress = "正在保存账号";
        StateHasChanged();
        try { await Workflow.PasswordLoginCompleteAsync(_pendingCookie!, _lifetime.Token); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { throw; }
        catch (Exception) { throw new PasswordLoginException("保存账号失败，请重试保存账号"); }
        if (_disposed) return;
        var userId = _pendingCookie!.UserId;
        _pendingCookie = null;
        MudDialog.Close(DialogResult.Ok(userId));
    }

    private async Task RestartAsync()
    {
        if (Busy || _loginClaimed) return;
        _officialUrl = null;
        _verification = false;
        _codeSent = false;
        _code = "";
        _password = "";
        await RefreshCaptchaAsync();
    }

    private async Task RunAsync(string progress, Func<Task> action, bool saving = false)
    {
        if (Busy || _disposed || (_loginClaimed && !saving)) return;
        _busy = true; _progress = progress; _message = null; _messageIsError = false;
        try { await action(); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested || _requests.IsCancellationRequested) { }
        catch (PasswordLoginException ex) { if (!_loginClaimed || saving) ShowError(ex.Message); }
        catch (Exception) { if (!_loginClaimed || saving) ShowError("本次操作未完成，请重试"); }
        finally { _busy = false; }
    }
    private void ShowError(string message) { _message = message; _messageIsError = true; }
    private async Task LoadCaptchaAsync()
    {
        var generation = ++_captchaGeneration;
        _widgetReady = false;
        _initializeWidget = false;
        _captcha = null;
        _imageCode = "";
        _captchaReady?.TrySetResult(false);
        _captchaReady = new(TaskCreationOptions.RunContinuationsAsynchronously);
        await DestroyCaptchaWidgetAsync();
        var captcha = await LoginService.PrepareCaptchaAsync(_verification, _requests.Token);
        _requests.Token.ThrowIfCancellationRequested();
        if (_disposed || _loginClaimed || generation != _captchaGeneration) return;
        _captcha = captcha;
        _initializeWidget = _captcha.Type == "geetest";
        if (!_initializeWidget) _captchaReady.TrySetResult(true);
    }
    private async Task DestroyCaptchaWidgetAsync()
    {
        if (_module is null || _disposed || _requests.IsCancellationRequested) return;
        try { await _module.InvokeVoidAsync("destroy", _requests.Token, _captchaId); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }
    private async Task CancelAsync() { await DisposeAsync(); MudDialog.Cancel(); }
    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true; _lifetime.Cancel(); _requests.Cancel(); _password = ""; _code = ""; _pendingCookie = null;
        _captchaReady?.TrySetResult(false);
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("destroy", _captchaId); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
        _requests.Dispose();
        _lifetime.Dispose();
    }
}
